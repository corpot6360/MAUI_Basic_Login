<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUI_Basic_Login.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,20"
            Spacing="20">

            <Label
                Text="Corey Potts"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1"
                HorizontalOptions="Center" />

            <Label
                Text="Login Screen"
                FontAttributes="Bold,Italic"
                FontSize="18"
                HorizontalOptions="Center" />

            <Label Text="User Name" />
            <Entry x:Name="UserEntry" Placeholder="Enter user name" />

            <Label Text="Password" />
            <Entry x:Name="PasswordEntry" Placeholder="Enter password" IsPassword="True" />

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button x:Name="LoginButton" Text="Login" Clicked="OnLoginClicked" />
                <Button x:Name="CancelButton" Text="Cancel" Clicked="OnCancelClicked" />
            </HorizontalStackLayout>

            <Label x:Name="MessageLabel" Text="" HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
